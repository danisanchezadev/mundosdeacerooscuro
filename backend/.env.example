# Copia este archivo a backend/.env y ajusta los valores.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# SQLite por defecto. Para PostgreSQL:
# DATABASE_URL=postgres://usuario:password@localhost:5432/mundos_acero_oscuro
# DATABASE_URL=sqlite:///db.sqlite3

# --- CORS / CSRF / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Google OAuth (flujo authorization code) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Cuentas ---
# none | optional | mandatory
ACCOUNT_EMAIL_VERIFICATION=optional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@mundosdeacerooscuro.local

# --- Rate limiting ---
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_WRITE=60/min
THROTTLE_AUTH=20/min

# --- Enlaces de compra ---
AMAZON_SEARCH_URL=https://www.amazon.es/s?i=stripbooks&k=
CASA_DEL_LIBRO_SEARCH_URL=https://www.casadellibro.com/busqueda-generica?busqueda=

# --- Scraping ---
SCRAPING_TIMEOUT=15

# --- Solo producción (config.settings.prod) ---
# SECURE_SSL_REDIRECT=True
