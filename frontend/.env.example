# URL base de la API. Vacío = mismo origen (en desarrollo Vite hace proxy de /api a Django).
VITE_API_URL=
# Client ID de Google OAuth (tipo "Aplicación web"). Si está vacío, el botón de Google se oculta.
VITE_GOOGLE_CLIENT_ID=
# Destino del proxy de desarrollo.
VITE_PROXY_TARGET=http://localhost:8000
